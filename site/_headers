# Cloudflare Pages headers. The page is fully static and self-hosted (fonts included), so the
# only third party it ever talks to is api.github.com — and only to resolve the latest installer.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src https://api.github.com; base-uri 'self'; form-action 'self'

# Long-cache the fingerprinted-ish static assets.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/shots/*
  Cache-Control: public, max-age=86400
